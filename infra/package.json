{
  "name": "swing-toulouse-infra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "swing-toulouse.fr on the shared Kapsule cluster, in Pulumi TypeScript.",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "pulumi preview",
    "up": "pulumi up"
  },
  "dependencies": {
    "@pulumi/cloudflare": "6.23.1",
    "@pulumi/kubernetes": "4.34.2",
    "@pulumi/pulumi": "3.272.0",
    "@pulumi/random": "4.21.4",
    "@pulumiverse/scaleway": "1.60.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
